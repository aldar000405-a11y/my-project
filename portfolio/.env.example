# ===========================================
# AI Portfolio Builder - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE (MongoDB)
# ===========================================
# Get your connection string from https://cloud.mongodb.com
# 1. Create a free cluster
# 2. Go to Database Access and create a user
# 3. Go to Network Access and add your IP (or 0.0.0.0/0 for all)
# 4. Click "Connect" on your cluster and copy the connection string
MONGODB_URI="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/ai-portfolio-builder?retryWrites=true&w=majority"

# ===========================================
# AUTHENTICATION (Clerk)
# ===========================================
# Get your keys from https://clerk.com
# 1. Create a new application
# 2. Go to API Keys in the left sidebar
# 3. Copy the publishable key and secret key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# Clerk URLs (these are the defaults, change if needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Clerk Webhook Secret (for user sync)
# Set this up in Clerk Dashboard > Webhooks
CLERK_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET"

# ===========================================
# PAYMENTS (Stripe)
# ===========================================
# Get your keys from https://stripe.com
# 1. Go to Developers > API Keys
# 2. Use test keys for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"

# Stripe Webhook Secret
# Set this up in Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# Stripe Price IDs (create products in Stripe Dashboard > Products)
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_YOUR_MONTHLY_PRICE_ID"
STRIPE_PREMIUM_YEARLY_PRICE_ID="price_YOUR_YEARLY_PRICE_ID"

# ===========================================
# AI (OpenAI)
# ===========================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-YOUR_OPENAI_API_KEY"

# Model to use (gpt-4o recommended for best results)
OPENAI_MODEL="gpt-4o"

# ===========================================
# APPLICATION
# ===========================================
# Your application URL (change for production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App name and description
NEXT_PUBLIC_APP_NAME="AI Portfolio Builder"

# Enable/disable features
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
